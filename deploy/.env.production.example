# =============================================================================
#  EduSkill Center — production .env  (sub-path deployment: /center)
# =============================================================================
#  Copy to <APP_DIR>/.env and fill in every value marked [MANDATORY].
#      cp deploy/.env.production.example .env
#      nano .env
#      chmod 600 .env && chown <APP_USER>:<APP_USER> .env
#
#  This file is read by:
#    * Next.js itself (next build / next start), from <APP_DIR>/.env
#    * prisma (prisma.config.ts does `import "dotenv/config"`)
#    * systemd, via EnvironmentFile= in deploy/eduskill-center.service
#
#  systemd caveat: it strips surrounding quotes but does NOT expand shell
#  syntax. Keep $ , ` and # out of passwords, or systemd will hand the app a
#  mangled value while `npm run start` from a shell works fine — a confusing
#  "works by hand, fails as a service" bug.
#
#  This TEMPLATE is committed (see the `!deploy/.env.production.example` negation
#  in .gitignore). The `.env` you create from it is NOT, and must never be —
#  it holds the database password and AUTH_SECRET. Keep it at chmod 600.
# =============================================================================


# ---- Sub-path mount -------------------------------------------------- [MANDATORY]
# BASE_PATH is a BUILD-TIME value. Changing it means re-running `npm run build`;
# restarting the service alone does nothing.
#   ""         -> app served at the domain root (local dev, or a dedicated domain)
#   "/center"  -> app served at https://eduskillindia.org/center   <- this deployment
BASE_PATH="/center"

# Public origin INCLUDING the sub-path, no trailing slash. This is what ends up
# in emails, certificate QR codes, sitemap.xml, robots.txt and OpenGraph tags.
# Get it wrong and links in emails/certificates point to the wrong place.
APP_URL="https://eduskillindia.org/center"

# Port the Node process listens on. 3001 keeps it clear of the existing site and
# of a local dev server on 3000. It must match proxy_pass/ProxyPass in the vhost
# and PORT= in the systemd unit.
PORT=3001

APP_NAME="EduSkill India Foundation"


# ---- Database --------------------------------------------------------- [MANDATORY]
# A DEDICATED database and a DEDICATED user — never the existing website's.
# Create them with deploy/postgres-setup.sql.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# If the password contains @ : / ? # or a space, percent-encode it
# (@ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL="postgresql://eduskill_center:<DB_PASSWORD>@127.0.0.1:5432/eduskill_center?schema=public"


# ---- Session signing --------------------------------------------------- [MANDATORY]
# 32+ random characters. Generate a fresh one ON THE SERVER — do not reuse the
# development value, and do not share it with the existing website:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later logs every user out (all existing sessions become invalid).
AUTH_SECRET="<PASTE_GENERATED_SECRET>"


# ---- First administrator ------------------------------ [MANDATORY for first seed]
# Used once by `npm run db:seed` to create the Super Admin. The seed REFUSES to
# run against a non-local database unless SEED_SUPER_ADMIN_PASSWORD is set.
# Change this password from inside the app right after the first login.
SEED_SUPER_ADMIN_EMAIL="superadmin@eduskillindia.org"
SEED_SUPER_ADMIN_PASSWORD="<STRONG_FIRST_PASSWORD>"

# Production MUST be "false": seeds reference data (states/districts/blocks,
# platform defaults, CMS sections) but NO demo students, trainers or centers.
SEED_DEMO="false"


# ---- File storage ------------------------------------------------------ [MANDATORY]
# local = files on this VPS's disk, served through /center/api/files/... with
# access control. Keep the directory INSIDE the app folder so the systemd
# ReadWritePaths in deploy/eduskill-center.service already covers it, and so
# nothing is ever written near the existing website.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# S3 / S3-compatible (DigitalOcean Spaces, MinIO, Wasabi). Only when
# STORAGE_DRIVER="s3". Leave blank otherwise.                         [optional]
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""


# ---- Email (SMTP) ------------------------------------------- [strongly recommended]
# Without this, no applicant ever receives a confirmation and no staff member is
# notified of new work; the app still runs and records everything as FAILED rows
# in Admin -> Notifications -> Log.
# These are FALLBACKS: whatever is saved in Admin -> Settings -> Communication
# takes priority once set in the UI.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EduSkill India Foundation <no-reply@eduskillindia.org>"


# ---- Payment gateway --------------------------------------------------- [optional]
# manual   = staff verify declared payments in the admin (no gateway needed)
# razorpay = online collection; fill in the three keys below.
# Also overridable from Admin -> Settings -> Payments.
PAYMENT_GATEWAY="manual"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# If you enable Razorpay, the webhook URL to register in their dashboard is:
#   https://eduskillindia.org/center/api/webhooks/razorpay


# ---- AI assistant (OpenAI) --------------------------------------------- [optional]
# Powers the bilingual (Hindi/English) assistant on the public website. Leave it empty
# and the assistant hides itself — the rest of the site is unaffected.
# This is a SERVER-ONLY secret: it is read only in src/server/chatbot.ts, never sent to
# the browser and never written into a response or a log line. Never rename it to
# NEXT_PUBLIC_OPENAI_API_KEY — that would publish it in the client bundle.
# The model, greeting, quick questions and the per-visitor hourly limit are edited in
# Admin -> Settings -> AI Assistant, so changing them needs no redeploy.
OPENAI_API_KEY=""


# ---- NOT used in production ---------------------------------------------------
# LOCAL_PG_* drive the embedded PostgreSQL used by `npm run db:local` during
# development only. Leave them out of the production .env entirely.
