# ---- Database ----
# Local development (started with `npm run db:local`)
DATABASE_URL="postgresql://eduskill:eduskill@localhost:5433/eduskill?schema=public"

# ---- Application ----
# URL prefix this deployment is mounted at. Leave EMPTY to serve the app at the domain root
# (local development and any dedicated domain). Set it to "/center" to serve the app from a
# sub-folder of a domain that already hosts another site, e.g. https://eduskillindia.org/center.
# It is a BUILD-TIME value: change it and re-run `npm run build`, restarting alone is not enough.
# When BASE_PATH is set, APP_URL must include the same prefix (see below).
BASE_PATH=""

# Public origin, including BASE_PATH when there is one. No trailing slash.
#   root deployment : APP_URL="https://eduskillindia.org"
#   sub-path deploy : APP_URL="https://eduskillindia.org/center"  (with BASE_PATH="/center")
APP_URL="http://localhost:3000"
APP_NAME="EduSkill India Foundation"
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# ---- Admin security (Secure Admin Login, 2FA, Security Center) ----
# Encrypts authenticator (2FA) secrets and the SMTP / SMS / WhatsApp passwords saved in Settings
# (AES-256-GCM, src/lib/crypto.ts). Generate once with:  openssl rand -base64 32
# NEVER change or lose it once anyone has set up 2FA or a password was saved in Settings: every
# stored secret becomes unreadable (2FA users must then be reset with `npm run security:recovery`).
# Leave it empty and 2FA set-up is refused; settings secrets are then stored unencrypted.
DATA_ENCRYPTION_KEY=""
# How many reverse proxies sit in front of the app and APPEND to X-Forwarded-For (nginx/Apache = 1).
# The client IP (rate limits, login history, new-device alerts) is read that many entries from the RIGHT.
TRUSTED_PROXY_HOPS="1"
# "1" only when the proxy OVERWRITES X-Real-IP with the real client address (nginx: proxy_set_header X-Real-IP $remote_addr).
TRUST_X_REAL_IP=""
# on (default): administrators may also sign in with a password (plus their authenticator when 2FA is on).
# off: Passwordless Secure Login only (email code), and admin password resets are disabled.
ADMIN_PASSWORD_LOGIN="on"
# An administrator is signed out after this many minutes without activity (5–480)…
ADMIN_IDLE_MINUTES="30"
# …and an administrator session never lasts longer than this many hours (1–72).
ADMIN_SESSION_HOURS="12"

# ---- Demo seed (only used by `npm run db:seed`) ----
# The first Super Admin. Admin sign-in codes are emailed to this address, so use a real mailbox.
SEED_SUPER_ADMIN_EMAIL="info@eduskillindia.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe@123"

# ---- File storage: local | s3 ----
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3 / S3-compatible (used when STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Email (SMTP) ----
# Fallbacks only: Admin → Settings → Communication (Super Admin) takes priority once saved there,
# including Encryption (SSL/TLS on 465 or STARTTLS on 587), From name/email and Reply-To.
# Hostinger mailbox info@eduskillindia.com: SMTP_HOST="smtp.hostinger.com", SMTP_PORT="465" (SSL) or "587" (STARTTLS).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EduSkill India Foundation <info@eduskillindia.com>"

# ---- Payment gateway: manual | razorpay ----
PAYMENT_GATEWAY="manual"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Local embedded PostgreSQL (npm run db:local) ----
LOCAL_PG_PORT="5433"
LOCAL_PG_USER="eduskill"
LOCAL_PG_PASSWORD="eduskill"
LOCAL_PG_DB="eduskill"

# ---- Seeding ----
# Set to "false" in production to seed only reference data and platform defaults (no demo records)
SEED_DEMO="true"

# ---- Gemini (optional: AI image generation for brand assets) ----
GEMINI_API_KEY=""

# ---- OpenAI (optional: the bilingual AI assistant on the public website) ----
# Server-only secret — never prefix it with NEXT_PUBLIC_. Leave it empty and the assistant
# simply hides itself; everything else on the site works exactly the same.
# Behaviour (model, greeting, quick questions, hourly limit) is edited in Admin → Settings → AI Assistant.
OPENAI_API_KEY=""
# Optional: point the assistant at an OpenAI-compatible gateway (corporate proxy, self-hosted
# relay) instead of api.openai.com. Give the API root INCLUDING the version segment, e.g.
# "https://gateway.example.com/v1". Leave it empty to call OpenAI directly.
OPENAI_BASE_URL=""
