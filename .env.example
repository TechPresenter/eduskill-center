# ---- Database ----
# Local development (started with `npm run db:local`)
DATABASE_URL="postgresql://eduskill:eduskill@localhost:5433/eduskill?schema=public"

# ---- Application ----
APP_URL="http://localhost:3000"
APP_NAME="EduSkill India Foundation"
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# ---- Demo seed (only used by `npm run db:seed`) ----
SEED_SUPER_ADMIN_EMAIL="superadmin@eduskillindia.org"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe@123"

# ---- File storage: local | s3 ----
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3 / S3-compatible (used when STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Email (SMTP) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EduSkill India Foundation <no-reply@eduskillindia.org>"

# ---- Payment gateway: manual | razorpay ----
PAYMENT_GATEWAY="manual"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Local embedded PostgreSQL (npm run db:local) ----
LOCAL_PG_PORT="5433"
LOCAL_PG_USER="eduskill"
LOCAL_PG_PASSWORD="eduskill"
LOCAL_PG_DB="eduskill"

# ---- Seeding ----
# Set to "false" in production to seed only reference data and platform defaults (no demo records)
SEED_DEMO="true"
