// ───────────────────── CENTRE APPLICATIONS (EduSkill Shiksha Mission) ─────────────────────
// A person applies to open a Normal Education Centre (Class 1–4) in their village/panchayat.
// Seven-step process: Application → Documents Verification → Centre Verification → Selection
// → Authorization/Agreement → Orientation → Centre Start.

enum CentreApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_REQUIRED
  DOCUMENTS_VERIFIED
  CENTRE_VERIFICATION
  SELECTED
  AGREEMENT_PENDING
  AGREEMENT_SIGNED
  ORIENTATION
  APPROVED
  REJECTED
}

enum CentreSpaceType {
  OWN
  RENTED
  COMMUNITY
  OTHER
}

model CentreApplication {
  id            String @id @default(uuid(7)) @db.Uuid
  applicationNo String @unique @map("application_no")

  // Applicant (the proposed centre operator)
  applicantName           String    @map("applicant_name")
  mobile                  String
  whatsapp                String?
  email                   String
  dob                     DateTime? @db.Date
  gender                  Gender?
  photoUrl                String?   @map("photo_url")
  qualification           String
  occupation              String?
  teachingExperienceYears Int       @default(0) @map("teaching_experience_years")

  // Where the centre would run
  stateId     String @map("state_id") @db.Uuid
  districtId  String @map("district_id") @db.Uuid
  blockId     String @map("block_id") @db.Uuid
  villageTown String @map("village_town")
  address     String
  pincode     String

  // The proposed centre itself
  proposedName     String          @map("proposed_name")
  spaceType        CentreSpaceType @default(OWN) @map("space_type")
  roomCount        Int             @default(1) @map("room_count")
  areaSqft         Int?            @map("area_sqft")
  seatingCapacity  Int             @default(0) @map("seating_capacity")
  hasElectricity   Boolean         @default(false) @map("has_electricity")
  hasToilet        Boolean         @default(false) @map("has_toilet")
  hasDrinkingWater Boolean         @default(false) @map("has_drinking_water")
  hasFurniture     Boolean         @default(false) @map("has_furniture")
  expectedStudents Int             @default(0) @map("expected_students")
  /// Classes the applicant intends to run, e.g. ["CLASS_1","CLASS_2"].
  classes          String[]        @default([])
  motivation       String

  // Foundation review
  status             CentreApplicationStatus @default(SUBMITTED)
  reviewNotes        String?                 @map("review_notes")
  rejectionReason    String?                 @map("rejection_reason")
  verificationAt     DateTime?               @map("verification_at")
  verificationNotes  String?                 @map("verification_notes")
  verifiedById       String?                 @map("verified_by_id") @db.Uuid
  agreementReference String?                 @map("agreement_reference")
  agreementSignedAt  DateTime?               @map("agreement_signed_at")
  orientationAt      DateTime?               @map("orientation_at")
  orientationMode    String?                 @map("orientation_mode")
  reviewedById       String?                 @map("reviewed_by_id") @db.Uuid

  /// Set when the application is approved and the training center record is created.
  centerId String? @unique @map("center_id") @db.Uuid

  submittedAt DateTime @default(now()) @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  state    State    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  block    Block    @relation(fields: [blockId], references: [id], onDelete: Restrict)
  center   Center?  @relation(fields: [centerId], references: [id], onDelete: SetNull)

  documents     CentreApplicationDocument[]
  statusHistory CentreApplicationStatusHistory[]

  @@index([status, submittedAt])
  @@index([stateId, districtId, blockId])
  @@index([email])
  @@index([mobile])
  @@map("centre_applications")
}

model CentreApplicationDocument {
  id            String         @id @default(uuid(7)) @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  type          String
  name          String
  url           String
  mimeType      String?        @map("mime_type")
  size          Int?
  status        DocumentStatus @default(PENDING)
  remarks       String?
  verifiedById  String?        @map("verified_by_id") @db.Uuid
  verifiedAt    DateTime?      @map("verified_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  application CentreApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("centre_application_documents")
}

model CentreApplicationStatusHistory {
  id            String                   @id @default(uuid(7)) @db.Uuid
  applicationId String                   @map("application_id") @db.Uuid
  fromStatus    CentreApplicationStatus? @map("from_status")
  toStatus      CentreApplicationStatus  @map("to_status")
  note          String?
  changedById   String?                  @map("changed_by_id") @db.Uuid
  createdAt     DateTime                 @default(now()) @map("created_at")

  application CentreApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("centre_application_status_history")
}
